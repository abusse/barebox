#!/bin/sh
# Boot the rescue system from NAND: zImage, device tree and initramfs
# (rootfs.cpio.uboot, a uImage) from their partitions, through the
# bad-block-skipping .bb devices.

global.bootm.image="/dev/nand0.kernel.bb"
global.bootm.oftree="/dev/nand0.dtb.bb"
global.bootm.initrd="/dev/nand0.rescue.bb"
global linux.bootargs.dyn.hostname="hostname=${global.hostname}"
