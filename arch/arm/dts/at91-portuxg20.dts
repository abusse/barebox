/*
 * barebox device tree for the taskit PortuxG20. The board part is the same
 * as the Linux at91-portuxg20.dts; barebox uses its legacy NAND driver
 * (as the Calao boards do) and keeps its environment in NAND.
 */
/dts-v1/;
#include <arm/microchip/at91sam9g20.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "taskit PortuxG20";
	compatible = "taskit,portuxg20", "atmel,at91sam9g20", "atmel,at91sam9";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@20000000 {
		reg = <0x20000000 0x4000000>;
	};

	clocks {
		slow_xtal {
			clock-frequency = <32768>;
		};

		main_xtal {
			clock-frequency = <18432000>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-2 {
			label = "portuxg20:red:led2";
			gpios = <&pioC 5 GPIO_ACTIVE_HIGH>;
		};

		led-3 {
			label = "portuxg20:green:led3";
			gpios = <&pioC 4 GPIO_ACTIVE_HIGH>;
		};

		led-4 {
			label = "portuxg20:yellow:led4";
			gpios = <&pioC 10 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-sw1 {
			label = "SW1";
			gpios = <&pioC 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PROG1>;
		};
	};

	onewire {
		compatible = "w1-gpio";
		gpios = <&pioA 29 GPIO_OPEN_DRAIN>;
	};
};

&pioA {
	/* low: 50 MHz RMII reference oscillator of the PHY on */
	phy-enable-hog {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "phy-enable";
	};
};

&pioC {
	/* high: RS-232 transceiver of X6/X4 (DBGU, USART2) on */
	rs232-enable-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "rs232-enable";
	};
};

&dbgu {
	status = "okay";
};

/* IF0, 3.3 V TTL, full modem lines */
&usart0 {
	pinctrl-0 = <&pinctrl_usart0
		     &pinctrl_usart0_rts
		     &pinctrl_usart0_cts
		     &pinctrl_usart0_dtr_dsr
		     &pinctrl_usart0_dcd
		     &pinctrl_usart0_ri>;
	status = "okay";
};

/* IF1 */
&usart1 {
	pinctrl-0 = <&pinctrl_usart1 &pinctrl_usart1_rts &pinctrl_usart1_cts>;
	status = "okay";
};

/* X6/X4 RS-232 */
&usart2 {
	pinctrl-0 = <&pinctrl_usart2 &pinctrl_usart2_rts &pinctrl_usart2_cts>;
	status = "okay";
};

/* IF4, IF5 */
&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&macb0 {
	phy-mode = "rmii";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* PHY interrupt (PA28) left out until its polarity is known */
	ethernet-phy@0 {
		reg = <0>;
	};
};

/* micro-SD X5 on slot A, no card-detect / write-protect lines */
&mmc0 {
	pinctrl-0 = <&pinctrl_mmc0_clk
		     &pinctrl_mmc0_slot0_cmd_dat0
		     &pinctrl_mmc0_slot0_dat1_3>;
	status = "okay";

	slot@0 {
		reg = <0>;
		bus-width = <4>;
	};
};

&ebi {
	status = "okay";
};

&nand_controller {
	pinctrl-0 = <&pinctrl_nand_cs &pinctrl_nand_rb>;
	pinctrl-names = "default";
	status = "okay";

	nand@3 {
		reg = <0x3 0x0 0x800000>;
		rb-gpios = <&pioC 13 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&pioC 14 GPIO_ACTIVE_HIGH>;
		nand-bus-width = <8>;
		nand-ecc-mode = "soft";
		label = "atmel_nand";

		/* same layout as the U-Boot mtdparts default */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "spl";
				reg = <0x0 0x20000>;
				read-only;
			};

			partition@20000 {
				label = "uboot";
				reg = <0x20000 0x100000>;
				read-only;
			};

			partition@120000 {
				label = "env";
				reg = <0x120000 0x40000>;
			};

			partition@160000 {
				label = "env_redund";
				reg = <0x160000 0x40000>;
			};

			partition@1a0000 {
				label = "dtb";
				reg = <0x1a0000 0x60000>;
			};

			partition@200000 {
				label = "kernel";
				reg = <0x200000 0x800000>;
			};

			partition@a00000 {
				label = "rescue";
				reg = <0xa00000 0x1000000>;
			};

			partition@1a00000 {
				label = "ubi";
				reg = <0x1a00000 0x6600000>;
			};
		};
	};
};

/* X9, two host ports */
&usb0 {
	num-ports = <2>;
	status = "okay";
};

/* X7 device port, VBUS sensed on PC7 */
&usb1 {
	atmel,vbus-gpio = <&pioC 7 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&i2c_gpio0 {
	status = "okay";
};

&shdwc {
	atmel,wakeup-counter = <10>;
	atmel,wakeup-rtt-timer;
};

&{/ahb/apb/rtc@fffffd20} {
	atmel,rtt-rtc-time-reg = <&gpbr 0x0>;
	status = "okay";
};

&gpbr {
	status = "okay";
};

#include "at91sam9g20.dtsi"

/ {
	chosen {
		environment {
			compatible = "barebox,environment";
			device-path = &env_nand;
		};
	};
};

&nand0 {
	nand-bus-width = <8>;
	nand-ecc-mode = "soft";
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "spl";
			reg = <0x0 0x20000>;
		};

		partition@20000 {
			label = "barebox";
			reg = <0x20000 0x100000>;
		};

		env_nand: partition@120000 {
			label = "env";
			reg = <0x120000 0x40000>;
		};

		partition@160000 {
			label = "env_redund";
			reg = <0x160000 0x40000>;
		};

		partition@1a0000 {
			label = "dtb";
			reg = <0x1a0000 0x60000>;
		};

		partition@200000 {
			label = "kernel";
			reg = <0x200000 0x800000>;
		};

		partition@a00000 {
			label = "rescue";
			reg = <0xa00000 0x1000000>;
		};

		partition@1a00000 {
			label = "ubi";
			reg = <0x1a00000 0x6600000>;
		};
	};
};
